    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@relay-miden/shared": "0.1.0",
    "cors": "^2.8.6",
    "express": "5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6"
  }
}
