# Copy to .env in the repository root. All values are non-secret.
# Express binds to loopback by default. LAN serving belongs to Phase 6.
PORT=3001
HOST=127.0.0.1
# Reserved frontend API base URL; Phase 1 UI does not call a task API.
# All VITE_ variables are public browser values. Never put secrets here.
VITE_API_URL=http://127.0.0.1:3001
